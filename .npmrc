# This project lives on an exFAT drive, which has no symlink support. npm's
# default bin-linking creates symlinks in node_modules/.bin, which silently
# fails here — `npx <tool>` and bare `<tool>` shell-outs then can't find the
# binary. Every package.json script therefore calls the binary's JS entry
# point directly (node node_modules/<pkg>/bin/...) instead of relying on
# node_modules/.bin, matching world-kitchen-atlas's setup on the same drive.
bin-links=false
