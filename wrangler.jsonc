{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "outreach-copilot",
	// Bump this only when you've read the Workers changelog for that date —
	// it opts into runtime behavior changes, not just a timestamp.
	"compatibility_date": "2026-08-14",

	// worker/index.ts runs for every request; the Cloudflare Vite plugin
	// serves the built React SPA from dist/client alongside it, and
	// run_worker_first ensures /api/* always hits the Worker instead of
	// falling through to a (non-existent) static file first.
	"main": "./worker/index.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "outreach-copilot-db",
			// Placeholder — real value is filled in after
			// `wrangler d1 create outreach-copilot-db` (see README "Getting
			// started"). Local dev works with this placeholder because
			// --local resolves the DB by name against .wrangler/state, not
			// this id.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],

	"ai": {
		"binding": "AI"
	},

	"vars": {
		// Any model in the Workers AI free-tier catalog works here; this one
		// is confirmed still free as of 2026-08 (glm-5.2/kimi-k2.x now
		// require the paid plan — see worker/lib/ai.ts). Swapping models is
		// a config edit, not a code change.
		"AI_MODEL": "@cf/zai-org/glm-4.7-flash"
	}

	// Secrets (never committed — set with `wrangler secret put <NAME>`,
	// or in .dev.vars locally, copied from .dev.vars.example):
	//   none yet in Phase 0. Phase 1 adds DASHBOARD_PASSWORD and
	//   SESSION_SECRET for the single-user login.
}
